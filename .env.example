DATABASE_URL=postgresql+psycopg://usuario:password@localhost:5432/energia_hsd
VITE_API_URL=http://127.0.0.1:8000

# Asistente plus: conexion de solo lectura. Crear el rol con docs/sql/asistente_readonly.sql.
ASISTENTE_DATABASE_URL=postgresql+psycopg://simet_asistente:CAMBIAR_PASSWORD@localhost:5544/energia_hsd
ASISTENTE_STATEMENT_TIMEOUT_MS=30000
ASISTENTE_RATE_LIMIT=30
ASISTENTE_RATE_WINDOW=60

# Proveedor LLM compatible con /chat/completions (OpenAI, Groq u Ollama local).
# Ollama: LLM_API_KEY puede quedar vacio solo si LLM_BASE_URL apunta a loopback.
# LLM_TIMEOUT limita la redaccion en segundos; por defecto 25.
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=
LLM_BASE_URL=
LLM_TIMEOUT=25

# RAG documental: embeddings en CPU y redacción con Cerebras (ver README, §15.6).
SIMET_RAG_ENABLED=0
CEREBRAS_API_KEY=
CEREBRAS_MODEL=qwen-3.8-27b
