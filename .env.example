# Copiar este archivo como .env y ajustar los valores

# Backend: cadena de conexión a PostgreSQL (SQLAlchemy + psycopg 3)
DATABASE_URL=postgresql+psycopg://usuario:password@localhost:5432/simet

# Frontend: URL base de la API (Vite solo expone variables con prefijo VITE_)
VITE_API_URL=http://127.0.0.1:8000
